FROM fedora:43

# Core dependencies — baked in, never pulled at test time
RUN dnf install -y \
    golang \
    podman \
    systemd \
    podlet \
    sudo \
    shadow-utils \
    util-linux \
    passwd \
    dbus-daemon \
    slirp4netns \
    fuse-overlayfs \
    iptables \
    && dnf clean all

# Create a non-root test user for rootless scenarios
RUN useradd -m -s /bin/bash testuser \
    && echo "testuser:100000:65536" >> /etc/subuid \
    && echo "testuser:100000:65536" >> /etc/subgid \
    && echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Enable linger so the user systemd instance starts at boot
RUN loginctl enable-linger testuser || true

# Helper script: starts systemd, builds comquad, runs tests.
# Usage:
#   podman run ... comquad-test:latest /entrypoint.sh            # root tests
#   podman run -e CQ_ROOTLESS=1 ... comquad-test:latest /entrypoint.sh  # rootless
COPY tests/integration/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

STOPSIGNAL SIGRTMIN+3
VOLUME ["/sys/fs/cgroup"]
CMD ["/sbin/init"]
